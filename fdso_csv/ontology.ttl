<https://w3id.org/fdso/#StateMinisterMembers> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/fdso/#StateMembers> ;
                                              rdfs:label "StateMinisterMembers" .


###  https://w3id.org/fdso/#StateMinistry
<https://w3id.org/fdso/#StateMinistry> rdf:type owl:Class ;
                                       rdfs:subClassOf <https://w3id.org/fdso/#Ministries> ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <https://w3id.org/fdso/#hasAutonomousOrganization> ;
                                                         owl:someValuesFrom <https://w3id.org/fdso/#AutonomousOrganizations>
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <https://w3id.org/fdso/#hasCorporations> ;
                                                         owl:someValuesFrom <https://w3id.org/fdso/#Corporations>
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <https://w3id.org/fdso/#hasLineDepartment> ;
                                                         owl:someValuesFrom <https://w3id.org/fdso/#StateLineDepartments>
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <https://w3id.org/fdso/#hasSecretariats> ;
                                                         owl:someValuesFrom <https://w3id.org/fdso/#Secretariats>
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <https://w3id.org/fdso/#hasSocieties> ;
                                                         owl:someValuesFrom <https://w3id.org/fdso/#Societies>
                                                       ] ,
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty <https://w3id.org/fdso/#supervises> ;
                                                         owl:someValuesFrom <https://w3id.org/fdso/#StateLineDepartments>
                                                       ] ;
                                       rdfs:label "StateMinistry"@en ;
                                       <http://www.w3.org/2004/02/skos/core#altLabel> "State Emergency Support Functionaries"@en .


