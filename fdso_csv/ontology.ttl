<https://w3id.org/fdso/#SearchandRescueResources> rdf:type owl:Class ;
                                                  rdfs:subClassOf <https://w3id.org/fdso/#Resources> ;
                                                  rdfs:comment "Classification adopted from the India Disaster Resource Network" ,
                                                               "SARResources" ,
                                                               "https://idrn.nidm.gov.in/ItemDetails/Index" ;
                                                  rdfs:label "SearchandRescueResources"@en .


