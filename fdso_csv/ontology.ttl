<https://w3id.org/fdso/#StateDisasterManagementAuthority> rdf:type owl:Class ;
                                                          rdfs:subClassOf <https://w3id.org/fdso/#DisasterManagementAuthority> ,
                                                                          [ rdf:type owl:Restriction ;
