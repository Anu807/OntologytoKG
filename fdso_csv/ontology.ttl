###  https://w3id.org/fdso/#EmergencyOperationCentre
<https://w3id.org/fdso/#EmergencyOperationCentre> rdf:type owl:Class ;
                                                  rdfs:subClassOf <http://www.w3.org/ns/org#OrganizationalUnit> ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#isEstablishedBy> ;
                                                                    owl:someValuesFrom <https://w3id.org/fdso/#DisasterManagementAuthority>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#needsInformationAbout> ;
                                                                    owl:someValuesFrom <https://w3id.org/fdso/#Data>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#needsInformationAbout> ;
                                                                    owl:someValuesFrom <https://w3id.org/fdso/#Disaster>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#needsInformationAbout> ;
                                                                    owl:someValuesFrom <https://w3id.org/fdso/#ExposedObjects>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#needsInformationAbout> ;
                                                                    owl:someValuesFrom <https://w3id.org/fdso/#Impacts>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#needsInformationAbout> ;
                                                                    owl:someValuesFrom <https://w3id.org/fdso/#Resources>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#passesDirectionsTo> ;
                                                                    owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#passesInformationAbout> ;
                                                                    owl:someValuesFrom <https://w3id.org/fdso/#Data>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#passesInformationAbout> ;
                                                                    owl:someValuesFrom <https://w3id.org/fdso/#Disaster>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#passesInformationAbout> ;
                                                                    owl:someValuesFrom <https://w3id.org/fdso/#ExposedObjects>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#passesInformationAbout> ;
                                                                    owl:someValuesFrom <https://w3id.org/fdso/#Impacts>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#passesInformationAbout> ;
                                                                    owl:someValuesFrom <https://w3id.org/fdso/#Resources>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#passesInformationTo> ;
                                                                    owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#receivesInformationFrom> ;
                                                                    owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#recievesInformationAbout> ;
                                                                    owl:someValuesFrom <https://w3id.org/fdso/#Data>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#recievesInformationAbout> ;
                                                                    owl:someValuesFrom <https://w3id.org/fdso/#Disaster>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#recievesInformationAbout> ;
                                                                    owl:someValuesFrom <https://w3id.org/fdso/#ExposedObjects>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#recievesInformationAbout> ;
                                                                    owl:someValuesFrom <https://w3id.org/fdso/#Impacts>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#recievesInformationAbout> ;
                                                                    owl:someValuesFrom <https://w3id.org/fdso/#Resources>
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#ContactPerson> ;
                                                                    owl:someValuesFrom xsd:string
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#Email> ;
                                                                    owl:someValuesFrom xsd:string
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#FaxNo.> ;
                                                                    owl:someValuesFrom xsd:string
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#HomePage> ;
                                                                    owl:someValuesFrom xsd:anyURI
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#OfficeAddress> ;
                                                                    owl:someValuesFrom xsd:string
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <https://w3id.org/fdso/#PhoneNumber> ;
                                                                    owl:someValuesFrom xsd:string
                                                                  ] ;
                                                  rdfs:comment "It is a main centralised facility that is capable of carrying out the core values of emergency preparedness and emergency management, as well as disaster management functions, at a tactical level when in a disaster, and guaranteeing the organisation, governmental agency, or other agency's continuity of operations." ,
                                                               "https://www.cdc.gov/cpr/eoc/eoc.htm" ;
                                                  rdfs:label "EmergencyOperationCentre" ;
                                                  <http://www.w3.org/2004/02/skos/core#altLabel> "Control Room"@en .


