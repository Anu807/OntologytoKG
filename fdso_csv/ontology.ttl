                                  rdfs:subClassOf <https://w3id.org/fdso/#IndustrialDisaster> ;
                                  rdfs:label "Collapse"@en .


###  https://w3id.org/fdso/#CollapseDisaster
<https://w3id.org/fdso/#CollapseDisaster> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/fdso/#MiscelleaneousDisaster> ;
                                          rdfs:label "CollapseDisaster"@en .


###  https://w3id.org/fdso/#Colleges
<https://w3id.org/fdso/#Colleges> rdf:type owl:Class ;
                                  rdfs:subClassOf <https://w3id.org/fdso/#EducationalFacilities> ;
                                  rdfs:label "Colleges" .


###  https://w3id.org/fdso/#Committee
<https://w3id.org/fdso/#Committee> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://xmlns.com/foaf/0.1/#Group> ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/fdso/#isCommitteeOf> ;
                                                     owl:someValuesFrom <http://www.w3.org/ns/org#Organization>
                                                   ] ;
                                   rdfs:comment "A body of persons delegated to consider, investigate, take action on, or report on some matter" ,
                                                "https://www.merriam-webster.com/dictionary/committee" ;
                                   rdfs:label "Committee" .


###  https://w3id.org/fdso/#CommunicationActivities
<https://w3id.org/fdso/#CommunicationActivities> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/fdso/#StabilizationActivities> ;
                                                 rdfs:label "CommunicationActivities"@en .


###  https://w3id.org/fdso/#CommunicationEquipments
<https://w3id.org/fdso/#CommunicationEquipments> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/fdso/#SearchandRescueResources> ;
                                                 rdfs:comment "Communication Equipments are the devices that help in transmitting the required information between individuals/agents."@en ;
                                                 rdfs:label "CommunicationEquipments" .


###  https://w3id.org/fdso/#CommunicationLine
<https://w3id.org/fdso/#CommunicationLine> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://w3id.org/fdso/#SupplyChannels> ;
                                           rdfs:label "CommunicationLine" .


###  https://w3id.org/fdso/#CommunicationTasks
<https://w3id.org/fdso/#CommunicationTasks> rdf:type owl:Class ;
                                            rdfs:subClassOf <https://w3id.org/fdso/#StabilizationTasks> ;
                                            rdfs:label "CommunicationTasks" .


###  https://w3id.org/fdso/#CommunicationTowers
<https://w3id.org/fdso/#CommunicationTowers> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/fdso/#Infrastructure> ;
                                             rdfs:label "CommunicationTowers" .


###  https://w3id.org/fdso/#CommunityHalls
<https://w3id.org/fdso/#CommunityHalls> rdf:type owl:Class ;
                                        rdfs:subClassOf <https://w3id.org/fdso/#SocialGatheringFacilities> ;
                                        rdfs:label "CommunityHalls" .


###  https://w3id.org/fdso/#Continent
<https://w3id.org/fdso/#Continent> rdf:type owl:Class ;
                                   rdfs:subClassOf <https://schema.org/Place> ;
                                   rdfs:label "Continent" .


###  https://w3id.org/fdso/#ConvectiveStorm
<https://w3id.org/fdso/#ConvectiveStorm> rdf:type owl:Class ;
                                         rdfs:subClassOf <https://w3id.org/fdso/#Storm> ;
                                         rdfs:label "ConvectiveStorm"@en .


###  https://w3id.org/fdso/#Corporations
<https://w3id.org/fdso/#Corporations> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/fdso/#StateLineDepartments> ,
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty <https://w3id.org/fdso/#isCorporationsOf> ;
                                                        owl:someValuesFrom <https://w3id.org/fdso/#StateMinistry>
                                                      ] ;
                                      rdfs:label "Corporations" ;
                                      <http://www.w3.org/2004/02/skos/core#altLabel> "Boards"@en .


###  https://w3id.org/fdso/#Cosmetics
<https://w3id.org/fdso/#Cosmetics> rdf:type owl:Class ;
                                   rdfs:subClassOf <https://w3id.org/fdso/#VictimUsableUtilities> ;
                                   rdfs:label "Cosmetics" .


###  https://w3id.org/fdso/#Country
<https://w3id.org/fdso/#Country> rdf:type owl:Class ;
                                 rdfs:subClassOf <https://schema.org/Place> ,
                                                 [ rdf:type owl:Restriction ;
                                                   owl:onProperty <https://w3id.org/fdso/#isCountryIn> ;
                                                   owl:someValuesFrom <https://w3id.org/fdso/#Continent>
                                                 ] ;
                                 rdfs:label "Country" .


###  https://w3id.org/fdso/#CrisisControlRoom
<https://w3id.org/fdso/#CrisisControlRoom> rdf:type owl:Class ;
                                           rdfs:subClassOf <http://www.w3.org/ns/org#OrganizationalUnit> ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <https://w3id.org/fdso/#isEstablishedBy> ;
                                                             owl:someValuesFrom <https://w3id.org/fdso/#StateLineDepartments>
                                                           ] ;
                                           rdfs:comment "Temporary organization set up agents to co-ordinate response at the groud level of a disaster."@en ;
                                           rdfs:label "CrisisControlRoom"@en .


###  https://w3id.org/fdso/#CriticalSupplies
<https://w3id.org/fdso/#CriticalSupplies> rdf:type owl:Class ;
                                          rdfs:subClassOf <https://w3id.org/fdso/#MedicalServiceUtilities> ;
                                          rdfs:label "CriticalSupplies" .


###  https://w3id.org/fdso/#CuttingEquipments
<https://w3id.org/fdso/#CuttingEquipments> rdf:type owl:Class ;
                                           rdfs:subClassOf <https://w3id.org/fdso/#SearchandRescueResources> ;
                                           rdfs:label "CuttingEquipments" .


###  https://w3id.org/fdso/#DamBreaks
<https://w3id.org/fdso/#DamBreaks> rdf:type owl:Class ;
                                   rdfs:subClassOf <https://w3id.org/fdso/#StructureDamages> ;
                                   rdfs:comment "When heavy rains come, and water levels rise, dams can fail and unleash torrents of water on unsuspecting households." ;
                                   rdfs:label "DamBreaks"@en ;
                                   <http://www.w3.org/2004/02/skos/core#altLabel> "Burst Dams"@en .


###  https://w3id.org/fdso/#Damage
<https://w3id.org/fdso/#Damage> rdf:type owl:Class ;
                                rdfs:subClassOf <https://w3id.org/fdso/#Impacts> ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty <https://w3id.org/fdso/#isDamageImpactsOn> ;
                                                  owl:someValuesFrom <https://w3id.org/fdso/#Infrastructure>
                                                ] ;
                                rdfs:comment "Disaster results in different types of consequences."@en ;
                                rdfs:label "Damage" .


###  https://w3id.org/fdso/#DamageandLossAssessmentActivities
<https://w3id.org/fdso/#DamageandLossAssessmentActivities> rdf:type owl:Class ;
                                                           rdfs:subClassOf <https://w3id.org/fdso/#ImmediateAssessmentActivities> ;
                                                           rdfs:label "DamageandLossAssessmentActivities" .


###  https://w3id.org/fdso/#DamageandLossAssessmentTasks
<https://w3id.org/fdso/#DamageandLossAssessmentTasks> rdf:type owl:Class ;
                                                      rdfs:subClassOf <https://w3id.org/fdso/#ImmediateAssessmentTasks> ;
                                                      rdfs:label "DamageandLossAssessmentTasks" .


###  https://w3id.org/fdso/#Data
<https://w3id.org/fdso/#Data> rdf:type owl:Class ;
                              rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                owl:onProperty <https://w3id.org/fdso/#isDataWith> ;
                                                owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty <https://w3id.org/fdso/#isUtilizedBy> ;
                                                owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty <https://w3id.org/fdso/#isUtilizedFor> ;
                                                owl:someValuesFrom <http://ontology.eil.utoronto.ca/icity/Activity/1.2/#Activity>
                                              ] ,
                                              [ rdf:type owl:Restriction ;
                                                owl:onProperty <https://w3id.org/fdso/#isUtilizedFor> ;
                                                owl:someValuesFrom <https://w3id.org/fdso/#Tasks>
                                              ] ;
                              rdfs:comment "During and before the flood disaster data is required by various stakeholders to take quick decisions."@en ;
                              rdfs:label "Data"@en .


###  https://w3id.org/fdso/#Derecho
<https://w3id.org/fdso/#Derecho> rdf:type owl:Class ;
                                 rdfs:subClassOf <https://w3id.org/fdso/#ConvectiveStorm> ;
                                 rdfs:label "Derecho"@en .


###  https://w3id.org/fdso/#Disaster
<https://w3id.org/fdso/#Disaster> rdf:type owl:Class ;
                                  rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event> ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://w3id.org/fdso/#causes> ;
                                                    owl:someValuesFrom <https://w3id.org/fdso/#Impacts>
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://w3id.org/fdso/#hasImpactOn> ;
                                                    owl:someValuesFrom <https://w3id.org/fdso/#ExposedObjects>
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://w3id.org/fdso/#hasNodalAgent> ;
                                                    owl:someValuesFrom <http://www.w3.org/ns/org#Organization>
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://w3id.org/fdso/#hasProcess> ;
                                                    owl:someValuesFrom <https://w3id.org/fdso/#Disaster_Management_Process>
                                                  ] ;
                                  rdfs:comment """The disaster classification specified by the Centre for Research on the Epidemiology of Disasters (CRED) in the EM-DAT is used for the ontology.
EM-DAT is a global database on natural and technological disasters, containing essential core data on the occurrence and effects of more than 21,000 disasters in the world, from 1900 to present. EM-DAT is maintained by the Centre for Research on the Epidemiology of Disasters (CRED)""" ,
                                               "https://emdat.be/" ,
                                               "https://emdat.be/classification" ;
                                  rdfs:label "Disaster" .


###  https://w3id.org/fdso/#DisasterManagementAuthority
<https://w3id.org/fdso/#DisasterManagementAuthority> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://www.w3.org/ns/org#OrganizationalUnit> ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <https://w3id.org/fdso/#establishes> ;
                                                                       owl:someValuesFrom <https://w3id.org/fdso/#EmergencyOperationCentre>
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <https://w3id.org/fdso/#hasHead> ;
                                                                       owl:someValuesFrom <https://w3id.org/fdso/#AgentMembers>
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <https://w3id.org/fdso/#hasMember> ;
                                                                       owl:someValuesFrom <https://w3id.org/fdso/#AgentMembers>
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <https://w3id.org/fdso/#needsInformationAbout> ;
                                                                       owl:someValuesFrom <https://w3id.org/fdso/#Disaster>
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <https://w3id.org/fdso/#passesDirectionAbout> ;
                                                                       owl:someValuesFrom <http://purl.obolibrary.org/obo/bfo.owl#Process>
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <https://w3id.org/fdso/#passesDirectionsTo> ;
                                                                       owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <https://w3id.org/fdso/#passesInformationTo> ;
                                                                       owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <https://w3id.org/fdso/#receivesInformationFrom> ;
                                                                       owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <https://w3id.org/fdso/#ContactPerson> ;
                                                                       owl:someValuesFrom xsd:string
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <https://w3id.org/fdso/#Email> ;
                                                                       owl:someValuesFrom xsd:string
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <https://w3id.org/fdso/#FaxNo.> ;
                                                                       owl:someValuesFrom xsd:string
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <https://w3id.org/fdso/#HomePage> ;
                                                                       owl:someValuesFrom xsd:anyURI
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <https://w3id.org/fdso/#OfficeAddress> ;
                                                                       owl:someValuesFrom xsd:string
                                                                     ] ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <https://w3id.org/fdso/#PhoneNumber> ;
                                                                       owl:someValuesFrom xsd:string
                                                                     ] ;
                                                     rdfs:comment "Conceptual and Institutional Framework of Disaster Management." ,
                                                                  "Organizations for Disaster Management." ;
                                                     rdfs:label "DisasterMangementAuthority" .


###  https://w3id.org/fdso/#DisasterManagerRole
<https://w3id.org/fdso/#DisasterManagerRole> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/fdso/#AgentMemberRole> ;
                                             rdfs:label "DisasterManagerRole" .


