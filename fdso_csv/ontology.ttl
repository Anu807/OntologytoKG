<https://w3id.org/fdso/#DisasterMaps> rdf:type owl:Class ;
                                      rdfs:subClassOf <https://w3id.org/fdso/#Maps> ;
                                      rdfs:label "DisasterMaps" .


###  https://w3id.org/fdso/#Disaster_Management_Process
<https://w3id.org/fdso/#Disaster_Management_Process> rdf:type owl:Class ;
                                                     rdfs:subClassOf <http://purl.obolibrary.org/obo/bfo.owl#Process> ,
                                                                     [ rdf:type owl:Restriction ;
                                                                       owl:onProperty <https://w3id.org/fdso/#isProcessOf> ;
                                                                       owl:someValuesFrom <https://w3id.org/fdso/#Disaster>
                                                                     ] ;
                                                     rdfs:label "DisasterManagementProcess"@en .


###  https://w3id.org/fdso/#District
<https://w3id.org/fdso/#District> rdf:type owl:Class ;
                                  rdfs:subClassOf <https://schema.org/Place> ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://w3id.org/fdso/#isDistrictIn> ;
                                                    owl:someValuesFrom <https://w3id.org/fdso/#City>
                                                  ] ;
                                  rdfs:label "District" .


###  https://w3id.org/fdso/#DistrictCollectorate
<https://w3id.org/fdso/#DistrictCollectorate> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/fdso/#UrbanLocalAuthorities> ;
                                              rdfs:comment "The Collectorate play a pivotal role in the District administration. Collector in the Cadre of I.A.S heads the District. He acts as the District Magistrate for maintaining Law and Order in his jurisdiction. He deals mainly with planning and development, law and order, general elections, arms licensing etc."@en ;
                                              rdfs:label "DistrictCollectorate"@en .


###  https://w3id.org/fdso/#DistrictDisasterManagementAuthority
<https://w3id.org/fdso/#DistrictDisasterManagementAuthority> rdf:type owl:Class ;
                                                             rdfs:subClassOf <https://w3id.org/fdso/#DisasterManagementAuthority> ;
                                                             rdfs:comment "DDMA will act as the planning, coordinating and implementing body for DM at District level and take all necessary measures for the purpose of DM, in accordance with the Guidelines laid down by the NDMA and SDMA."@en ;
                                                             rdfs:label "DistrictDisasterManagementAuthority"@en .


###  https://w3id.org/fdso/#DistrictEmergencyOperationCentre
<https://w3id.org/fdso/#DistrictEmergencyOperationCentre> rdf:type owl:Class ;
                                                          rdfs:subClassOf <https://w3id.org/fdso/#EmergencyOperationCentre> ,
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <https://w3id.org/fdso/#isEstablishedBy> ;
                                                                            owl:someValuesFrom <https://w3id.org/fdso/#DistrictDisasterManagementAuthority>
                                                                          ] ;
                                                          rdfs:label "DistrictEmergencyOperationsCentre"@en .


###  https://w3id.org/fdso/#DistrictMemberRole
