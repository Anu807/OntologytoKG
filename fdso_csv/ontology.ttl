                                                    rdfs:label "StateLineDepartmentMembers" .


###  https://w3id.org/fdso/#StateLineDepartmentRole
<https://w3id.org/fdso/#StateLineDepartmentRole> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/fdso/#StateMemberRole> ;
                                                 rdfs:label "StateLineDepartmentMemberRole" .


###  https://w3id.org/fdso/#StateLineDepartments
<https://w3id.org/fdso/#StateLineDepartments> rdf:type owl:Class ;
                                              rdfs:subClassOf <https://w3id.org/fdso/#LineDepartments> ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://w3id.org/fdso/#assists> ;
                                                                owl:someValuesFrom <http://ontology.eil.utoronto.ca/icity/Activity/1.2/#Activity>
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://w3id.org/fdso/#assists> ;
                                                                owl:someValuesFrom <https://w3id.org/fdso/#Tasks>
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://w3id.org/fdso/#hasData> ;
                                                                owl:someValuesFrom <https://w3id.org/fdso/#Data>
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://w3id.org/fdso/#hasNodalOfficer> ;
                                                                owl:someValuesFrom <https://w3id.org/fdso/#StateMembers>
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://w3id.org/fdso/#hasResources> ;
                                                                owl:someValuesFrom <https://w3id.org/fdso/#Resources>
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://w3id.org/fdso/#isLineDepartmentOf> ;
                                                                owl:someValuesFrom <https://w3id.org/fdso/#StateMinistry>
                                                              ] ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://w3id.org/fdso/#isNodalAgentOf> ;
                                                                owl:someValuesFrom <https://w3id.org/fdso/#Disaster>
                                                              ] ;
                                              rdfs:label "StateLineDepartments"@en .


