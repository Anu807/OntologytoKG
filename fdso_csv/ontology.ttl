#################################################################
#    Classes
#################################################################

###  http://ontology.eil.utoronto.ca/icity/Activity/1.2/#Activity
<http://ontology.eil.utoronto.ca/icity/Activity/1.2/#Activity> rdf:type owl:Class ;
                                                               rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event> ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <https://w3id.org/fdso/#hasLocation> ;
                                                                                 owl:someValuesFrom <https://schema.org/Place>
                                                                               ] ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <https://w3id.org/fdso/#hasNodalAgent> ;
                                                                                 owl:someValuesFrom <http://www.w3.org/ns/org#Organization>
                                                                               ] ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <https://w3id.org/fdso/#hasTask> ;
                                                                                 owl:someValuesFrom <https://w3id.org/fdso/#Tasks>
                                                                               ] ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <https://w3id.org/fdso/#isActivityOf> ;
                                                                                 owl:someValuesFrom <http://purl.obolibrary.org/obo/bfo.owl#Process>
                                                                               ] ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <https://w3id.org/fdso/#isPerformedBy> ;
                                                                                 owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                                               ] ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <https://w3id.org/fdso/#isPerformedFor> ;
                                                                                 owl:someValuesFrom <https://w3id.org/fdso/#Disaster>
                                                                               ] ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <https://w3id.org/fdso/#HasEndDateAndTime> ;
                                                                                 owl:someValuesFrom xsd:dateTime
                                                                               ] ,
                                                                               [ rdf:type owl:Restriction ;
                                                                                 owl:onProperty <https://w3id.org/fdso/#HasStartDateAndTime> ;
                                                                                 owl:someValuesFrom xsd:dateTime
                                                                               ] ;
                                                               rdfs:comment "An Activity describes something that occurs in the domain" ;
                                                               rdfs:label "Activity"@en ;
                                                               <http://www.w3.org/2004/02/skos/core#altLabel> "Capabilities (NDMP)"@en .


###  http://purl.obolibrary.org/obo/bfo.owl#Process
<http://purl.obolibrary.org/obo/bfo.owl#Process> rdf:type owl:Class ;
                                                 rdfs:subClassOf <http://purl.org/NET/c4dm/event.owl#Event> ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <https://w3id.org/fdso/#hasActivity> ;
                                                                   owl:someValuesFrom <http://ontology.eil.utoronto.ca/icity/Activity/1.2/#Activity>
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <https://w3id.org/fdso/#hasAgents> ;
                                                                   owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <https://w3id.org/fdso/#hasLocation> ;
                                                                   owl:someValuesFrom <https://schema.org/Place>
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <https://w3id.org/fdso/#isSupervisedBy> ;
                                                                   owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <https://w3id.org/fdso/#HasEndDateAndTime> ;
                                                                   owl:someValuesFrom xsd:dateTime
                                                                 ] ,
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty <https://w3id.org/fdso/#HasStartDateAndTime> ;
                                                                   owl:someValuesFrom xsd:dateTime
                                                                 ] ;
                                                 rdfs:label "Process"@en .


###  http://purl.obolibrary.org/obo/roleo.owl#OccupationalRole
<http://purl.obolibrary.org/obo/roleo.owl#OccupationalRole> rdf:type owl:Class ;
                                                            rdfs:subClassOf <http://purl.obolibrary.org/obo/roleo.owl#SocialRole> ;
                                                            rdfs:label "OccupationRole" .


###  http://purl.obolibrary.org/obo/roleo.owl#Role
<http://purl.obolibrary.org/obo/roleo.owl#Role> rdf:type owl:Class ;
                                                rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                  owl:onProperty <https://w3id.org/fdso/#isRoleOf> ;
                                                                  owl:someValuesFrom <https://w3id.org/fdso/#AgentMembers>
                                                                ] ;
                                                rdfs:comment "A classification of the diverse roles performed by the person in different organization" ;
                                                rdfs:label "Role" .


###  http://purl.obolibrary.org/obo/roleo.owl#SocialRole
<http://purl.obolibrary.org/obo/roleo.owl#SocialRole> rdf:type owl:Class ;
                                                      rdfs:subClassOf <http://purl.obolibrary.org/obo/roleo.owl#Role> ;
                                                      rdfs:label "SocialRole" .


###  http://purl.org/NET/c4dm/event.owl#Event
<http://purl.org/NET/c4dm/event.owl#Event> rdf:type owl:Class ;
                                           rdfs:subClassOf owl:Thing ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <https://w3id.org/fdso/#hasAgents> ;
                                                             owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <https://w3id.org/fdso/#hasLocation> ;
                                                             owl:someValuesFrom <https://schema.org/Place>
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <https://w3id.org/fdso/#HasEndDateAndTime> ;
                                                             owl:someValuesFrom xsd:dateTime
                                                           ] ,
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty <https://w3id.org/fdso/#HasStartDateAndTime> ;
                                                             owl:someValuesFrom xsd:dateTime
                                                           ] ;
                                           rdfs:comment "Events are things that happen." ;
                                           rdfs:label "Event" .


###  http://www.w3.org/ns/org#Organization
<http://www.w3.org/ns/org#Organization> rdf:type owl:Class ;
                                        rdfs:subClassOf <http://xmlns.com/foaf/0.1/Agent> ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/fdso/#assists> ;
                                                          owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/fdso/#coordinateWith> ;
                                                          owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/fdso/#hasLocation> ;
                                                          owl:someValuesFrom <https://schema.org/Place>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/fdso/#isAssistedBy> ;
                                                          owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/fdso/#isSupervisedBy> ;
                                                          owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/fdso/#passesInformationTo> ;
                                                          owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/fdso/#receivesInformationFrom> ;
                                                          owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                        ] ,
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty <https://w3id.org/fdso/#supervises> ;
                                                          owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                        ] ;
                                        rdfs:comment "A group of people working together."@en ;
                                        rdfs:label "Organization"@en .


###  http://www.w3.org/ns/org#OrganizationalUnit
<http://www.w3.org/ns/org#OrganizationalUnit> rdf:type owl:Class ;
                                              rdfs:subClassOf <http://www.w3.org/ns/org#Organization> ,
                                                              [ rdf:type owl:Restriction ;
                                                                owl:onProperty <https://w3id.org/fdso/#isPartOf> ;
                                                                owl:someValuesFrom <https://w3id.org/fdso/#GovernmentalOrganization>
                                                              ] ;
                                              rdfs:label "OrganizationalUnit" .


###  http://xmlns.com/foaf/0.1/Agent
<http://xmlns.com/foaf/0.1/Agent> rdf:type owl:Class ;
                                  rdfs:subClassOf owl:Thing ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://w3id.org/fdso/#performs> ;
                                                    owl:someValuesFrom <http://ontology.eil.utoronto.ca/icity/Activity/1.2/#Activity>
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://w3id.org/fdso/#performs> ;
                                                    owl:someValuesFrom <https://w3id.org/fdso/#Tasks>
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty <https://w3id.org/fdso/#supervises> ;
                                                    owl:someValuesFrom <http://purl.obolibrary.org/obo/bfo.owl#Process>
                                                  ] ;
                                  rdfs:comment "An agent (eg. person, group, software or physical artifact)."@en ;
                                  rdfs:label "Agent"@en .


###  http://xmlns.com/foaf/0.1/#Group
<http://xmlns.com/foaf/0.1/#Group> rdf:type owl:Class ;
                                   rdfs:subClassOf <http://xmlns.com/foaf/0.1/Agent> ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/fdso/#assists> ;
                                                     owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/fdso/#coordinateWith> ;
                                                     owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/fdso/#hasHead> ;
                                                     owl:someValuesFrom <https://w3id.org/fdso/#AgentMembers>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/fdso/#hasMember> ;
                                                     owl:someValuesFrom <https://w3id.org/fdso/#AgentMembers>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/fdso/#isAssistedBy> ;
                                                     owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/fdso/#isSupervisedBy> ;
                                                     owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/fdso/#needsInformationAbout> ;
                                                     owl:someValuesFrom <http://purl.obolibrary.org/obo/bfo.owl#Process>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/fdso/#needsInformationAbout> ;
                                                     owl:someValuesFrom <https://w3id.org/fdso/#Disaster>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/fdso/#passesInformationAbout> ;
                                                     owl:someValuesFrom <http://purl.obolibrary.org/obo/bfo.owl#Process>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/fdso/#passesInformationTo> ;
                                                     owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/fdso/#receivesInformationFrom> ;
                                                     owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                   ] ,
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty <https://w3id.org/fdso/#supervises> ;
                                                     owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                   ] ;
                                   rdfs:comment "A collection of individual agents." ,
                                                "http://xmlns.com/foaf/spec/#term_Group" ;
                                   rdfs:label "Group" .


###  http://xmlns.com/foaf/0.1/#Person
<http://xmlns.com/foaf/0.1/#Person> rdf:type owl:Class ;
                                    rdfs:subClassOf <http://xmlns.com/foaf/0.1/Agent> ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://w3id.org/fdso/#assists> ;
                                                      owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://w3id.org/fdso/#coordinateWith> ;
                                                      owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://w3id.org/fdso/#isAssistedBy> ;
                                                      owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://w3id.org/fdso/#isSupervisedBy> ;
                                                      owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://w3id.org/fdso/#passesInformationTo> ;
                                                      owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://w3id.org/fdso/#receivesInformationFrom> ;
                                                      owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <https://w3id.org/fdso/#supervises> ;
                                                      owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                    ] ;
                                    rdfs:comment "A human being"@en ,
                                                 "A human being at a position of responsibility to take care of managing the situation during a disaster." ;
                                    rdfs:label "Person"@en .


###  https://schema.org/Place
<https://schema.org/Place> rdf:type owl:Class ;
                           rdfs:subClassOf [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/fdso/#GeographicAreaCoverage> ;
                                             owl:someValuesFrom xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/fdso/#GovernmentType> ;
                                             owl:someValuesFrom xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/fdso/#Latitude> ;
                                             owl:someValuesFrom xsd:decimal
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/fdso/#Longitude> ;
                                             owl:someValuesFrom xsd:decimal
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/fdso/#Name> ;
                                             owl:someValuesFrom xsd:string
                                           ] ,
                                           [ rdf:type owl:Restriction ;
                                             owl:onProperty <https://w3id.org/fdso/#PopulationDensity> ;
                                             owl:someValuesFrom xsd:string
                                           ] ;
                           rdfs:comment "Entities that have a somewhat fixed, physical extension." ;
                           rdfs:label "Place" .


###  https://w3id.org/fdso/#AgentMemberRole
<https://w3id.org/fdso/#AgentMemberRole> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://purl.obolibrary.org/obo/roleo.owl#OccupationalRole> ;
                                         rdfs:comment "It is defined by the role that agent members carry out in response to a disaster or the positions they hold in the organizations they belong to."@en ;
                                         rdfs:label "AgentMemberRole"@en .


###  https://w3id.org/fdso/#AgentMembers
<https://w3id.org/fdso/#AgentMembers> rdf:type owl:Class ;
