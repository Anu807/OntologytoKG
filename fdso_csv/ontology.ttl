<https://w3id.org/fdso/#StateLevelCommittee> rdf:type owl:Class ;
                                             rdfs:subClassOf <https://w3id.org/fdso/#Committee> ;
                                             rdfs:comment "Committee functional at state level and supported by state ministry."@en ;
                                             rdfs:label "StateLevelCommittee"@en .


