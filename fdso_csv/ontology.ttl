<https://w3id.org/fdso/#StateMinisterMemberRole> rdf:type owl:Class ;
                                                 rdfs:subClassOf <https://w3id.org/fdso/#StateMemberRole> ;
                                                 rdfs:label "StateMinisterMemberRole" .


