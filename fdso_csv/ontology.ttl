                                                          owl:someValuesFrom <https://w3id.org/fdso/#Disaster>
                                                        ] ;
                                        rdfs:comment "Objects that are exposed to be impacted by an disaster."@en ,
                                                     "Authors : Walid Bannour, Ahmed Maalel Henda, Hajjami Ben Ghezala" ,
                                                     "CROnto ontology" ,
                                                     "The main concepts of the CROnto ontology about Exposed Objects were adopted in the ontology" ;
                                        rdfs:label "ExposedObjects"@en .


