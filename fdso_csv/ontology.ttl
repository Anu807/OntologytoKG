###  https://w3id.org/fdso/#LineDepartments
<https://w3id.org/fdso/#LineDepartments> rdf:type owl:Class ;
                                         rdfs:subClassOf <http://www.w3.org/ns/org#OrganizationalUnit> ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/fdso/#hasHead> ;
                                                           owl:someValuesFrom <https://w3id.org/fdso/#AgentMembers>
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/fdso/#hasMember> ;
                                                           owl:someValuesFrom <https://w3id.org/fdso/#AgentMembers>
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/fdso/#ContactPerson> ;
                                                           owl:someValuesFrom xsd:string
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/fdso/#Email> ;
                                                           owl:someValuesFrom xsd:string
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/fdso/#FacebookAccountHomepage> ;
                                                           owl:someValuesFrom xsd:anyURI
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/fdso/#FaxNo.> ;
                                                           owl:someValuesFrom xsd:string
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/fdso/#HomePage> ;
                                                           owl:someValuesFrom xsd:anyURI
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/fdso/#OfficeAddress> ;
                                                           owl:someValuesFrom xsd:string
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/fdso/#PhoneNumber> ;
                                                           owl:someValuesFrom xsd:string
                                                         ] ,
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty <https://w3id.org/fdso/#TwitterAccountHomepage> ;
                                                           owl:someValuesFrom xsd:anyURI
                                                         ] ;
                                         rdfs:comment "Line departments, whether in public administration, the military or various businesses, are those departments within an organization which focus on the primary function and work of the organization"@en ,
                                                      "https://findanyanswer.com/what-is-the-difference-between-a-staff-and-line-agency#:~:text=Line%20agencies%2C%20whether%20in%20public%20administration%2C%20the%20military,the%20line%20agencies.%20Click%20to%20see%20full%20answer"@en ;
                                         rdfs:label "LineDepartments"@en ;
                                         <http://www.w3.org/2004/02/skos/core#altLabel> "Line Agency"@en .


