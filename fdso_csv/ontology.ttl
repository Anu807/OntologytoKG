###  https://w3id.org/fdso/#NationalDisasterResponseForce
<https://w3id.org/fdso/#NationalDisasterResponseForce> rdf:type owl:Class ;
                                                       rdfs:subClassOf <https://w3id.org/fdso/#CentralResponseForce> ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://w3id.org/fdso/#hasCAPF> ;
                                                                         owl:someValuesFrom <https://w3id.org/fdso/#CentralArmedPoliceForces>
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://w3id.org/fdso/#hasCommandant> ;
                                                                         owl:someValuesFrom <https://w3id.org/fdso/#CentralResponseForceMembers>
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://w3id.org/fdso/#hasHead> ;
                                                                         owl:someValuesFrom <https://w3id.org/fdso/#AgentMembers>
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://w3id.org/fdso/#needsInformationAbout> ;
                                                                         owl:someValuesFrom <https://w3id.org/fdso/#Disaster>
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://w3id.org/fdso/#needsInformationAbout> ;
                                                                         owl:someValuesFrom <https://w3id.org/fdso/#ExposedObjects>
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://w3id.org/fdso/#needsInformationAbout> ;
                                                                         owl:someValuesFrom <https://w3id.org/fdso/#Impacts>
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://w3id.org/fdso/#receivesInformationFrom> ;
                                                                         owl:someValuesFrom <http://xmlns.com/foaf/0.1/Agent>
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://w3id.org/fdso/#BattalionNumber> ;
                                                                         owl:someValuesFrom xsd:integer
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://w3id.org/fdso/#BattlionAddress> ;
                                                                         owl:someValuesFrom xsd:string
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://w3id.org/fdso/#BattlionTwitterHomePage> ;
                                                                         owl:someValuesFrom xsd:anyURI
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://w3id.org/fdso/#NumberOfMembersInEachBattlion> ;
                                                                         owl:someValuesFrom xsd:integer
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://w3id.org/fdso/#NumberOfMembersInSearchAndRescueTeams> ;
                                                                         owl:someValuesFrom xsd:integer
                                                                       ] ,
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty <https://w3id.org/fdso/#NumberOfSearchAndRescueTeams> ;
                                                                         owl:someValuesFrom xsd:integer
                                                                       ] ;
                                                       rdfs:comment "NDRF"@en ,
                                                                    "Specialized disaster reponse force for the purpose of tackling natural and man-made disasters." ,
                                                                    "http://ndrf.gov.in/about-us" ;
                                                       rdfs:label "NationalDisasterResponseForce" .


