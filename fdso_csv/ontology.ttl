#################################################################
#    Object Properties
#################################################################

###  https://w3id.org/fdso/#assists
<https://w3id.org/fdso/#assists> rdf:type owl:ObjectProperty ;
                                 rdfs:subPropertyOf owl:topObjectProperty ;
                                 owl:inverseOf <https://w3id.org/fdso/#isAssistedBy> ;
                                 rdfs:domain <http://xmlns.com/foaf/0.1/Agent> ;
                                 rdfs:range [ rdf:type owl:Class ;
                                              owl:unionOf ( <http://ontology.eil.utoronto.ca/icity/Activity/1.2/#Activity>
                                                            <http://purl.obolibrary.org/obo/bfo.owl#Process>
                                                            <http://xmlns.com/foaf/0.1/Agent>
                                                            <https://w3id.org/fdso/#Tasks>
                                                          )
                                            ] ;
                                 rdfs:label "assists" .


###  https://w3id.org/fdso/#causes
<https://w3id.org/fdso/#causes> rdf:type owl:ObjectProperty ;
                                owl:inverseOf <https://w3id.org/fdso/#isCausedBy> ;
                                rdfs:domain [ rdf:type owl:Class ;
                                              owl:unionOf ( <https://w3id.org/fdso/#CityFloodCauses>
                                                            <https://w3id.org/fdso/#Disaster>
                                                          )
                                            ] ;
                                rdfs:range [ rdf:type owl:Class ;
                                             owl:unionOf ( <https://w3id.org/fdso/#Flood>
                                                           <https://w3id.org/fdso/#Impacts>
                                                         )
                                           ] ;
                                rdfs:label "causes" .


###  https://w3id.org/fdso/#comprisesInformationFor
<https://w3id.org/fdso/#comprisesInformationFor> rdf:type owl:ObjectProperty ;
                                                 rdfs:subPropertyOf owl:topObjectProperty ;
                                                 owl:inverseOf <https://w3id.org/fdso/#recievesInformationAbout> ;
                                                 rdfs:domain [ rdf:type owl:Class ;
                                                               owl:unionOf ( <https://w3id.org/fdso/#Data>
                                                                             <https://w3id.org/fdso/#Disaster>
                                                                             <https://w3id.org/fdso/#ExposedObjects>
                                                                             <https://w3id.org/fdso/#Resources>
                                                                           )
                                                             ] ;
                                                 rdfs:range <http://xmlns.com/foaf/0.1/Agent> ;
                                                 rdfs:label "comprisesInformationFor" .


###  https://w3id.org/fdso/#consistsInformationFor
<https://w3id.org/fdso/#consistsInformationFor> rdf:type owl:ObjectProperty ;
                                                rdfs:subPropertyOf owl:topObjectProperty ;
                                                owl:inverseOf <https://w3id.org/fdso/#passesInformationAbout> ;
                                                rdfs:domain [ rdf:type owl:Class ;
                                                              owl:unionOf ( <http://purl.obolibrary.org/obo/bfo.owl#Process>
                                                                            <https://w3id.org/fdso/#Data>
                                                                            <https://w3id.org/fdso/#Disaster>
                                                                            <https://w3id.org/fdso/#ExposedObjects>
                                                                            <https://w3id.org/fdso/#Resources>
                                                                          )
                                                            ] ;
                                                rdfs:range <http://xmlns.com/foaf/0.1/Agent> ;
                                                rdfs:label "consistsInformationFor" .


